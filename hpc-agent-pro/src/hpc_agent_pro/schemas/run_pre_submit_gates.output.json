{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesdchen/hpc-agent/schemas/run_pre_submit_gates.output.json",
  "title": "run-pre-submit-gates output data",
  "type": "object",
  "required": [
    "gates",
    "overall"
  ],
  "additionalProperties": false,
  "properties": {
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/_GateOutcome"
      },
      "description": "Per-gate outcome keyed by gate name (``check-preflight``, ``validate-campaign``, ``predict-start-time``).",
      "title": "Gates",
      "type": "object"
    },
    "overall": {
      "description": "``ok`` when every non-skipped gate passed; ``blocked`` when any gate failed (and the rest short-circuited); ``skipped`` when every gate was skipped.",
      "enum": [
        "ok",
        "blocked",
        "skipped"
      ],
      "title": "Overall",
      "type": "string"
    }
  },
  "$defs": {
    "_GateOutcome": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "ok",
            "skipped",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "envelope": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The gate's structured output (when status==ok) or failure detail (when status==failed).",
          "title": "Envelope"
        }
      },
      "required": [
        "status"
      ],
      "title": "_GateOutcome",
      "type": "object"
    }
  }
}
