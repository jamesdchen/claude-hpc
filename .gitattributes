# Normalize all text files to LF on commit; check out with native EOL.
# Prevents CRLF from Windows checkouts breaking shell scripts executed on Linux clusters.
* text=auto eol=lf

# Scripts executed on remote Linux clusters — MUST be LF or shebang breaks.
*.sh    text eol=lf
*.slurm text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

# Append-only logs: union-merge so parallel branches' added lines are kept
# (both sides concatenated) instead of conflicting. CHANGELOG entries land
# under [Unreleased]; order within the section doesn't matter and a release
# reflows it — so a union merge is always safe, never a hard conflict.
CHANGELOG.md merge=union

# Binary files (explicit to avoid accidental normalization)
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gz   binary
*.zip  binary
