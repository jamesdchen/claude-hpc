{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jamesdchen/hpc-agent/schemas/resolve_submit_inputs.input.json",
  "title": "resolve-submit-inputs input spec",
  "description": "Spec passed to ``hpc-agent resolve-submit-inputs --spec <file>``.\n\nCarries exactly the values the deterministic chain needs that the\ncaller has already resolved upstream: the human-chosen ``run_name``\n(drives ``compute-run-id``), the full ``build-submit-spec`` input\n(re-used verbatim so cluster / profile / backend / job_env / etc. are\nnot re-enumerated here), and an optional ``build_tasks`` scaffold spec\nused only when ``.hpc/tasks.py`` is absent. ``experiment_dir`` is the\nframework-context positional arg, intentionally NOT a spec field.",
  "type": "object",
  "required": [
    "run_name",
    "submit"
  ],
  "additionalProperties": false,
  "properties": {
    "run_name": {
      "description": "Human-chosen run name fed to compute-run-id; combined with the cmd_sha prefix to form run_id (<run_name>-<sha[:8]>).",
      "minLength": 1,
      "title": "Run Name",
      "type": "string"
    },
    "submit": {
      "$ref": "#/$defs/BuildSubmitSpecInput",
      "description": "The resolved build-submit-spec input (profile / cluster / ssh_target / remote_path / run_id / total_tasks / backend / job_env knobs). resolve-submit-inputs feeds this to build-submit-spec to assemble the validated submit-flow spec after the run_id / prior-run / tasks.py branches clear."
    },
    "build_tasks": {
      "anyOf": [
        {
          "$ref": "#/$defs/BuildTasksPyInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional pre-classified build-tasks-py spec (axes + flags_by_executor + optional data_axis). Used ONLY when <experiment_dir>/.hpc/tasks.py is absent and can be scaffolded deterministically. When tasks.py is absent and this is null, the composite escalates needs_scaffold_interview rather than guessing."
    }
  },
  "$defs": {
    "BuildSubmitSpecInput": {
      "additionalProperties": false,
      "description": "Resolved interview values fed to ``hpc_agent.incorporation.build.submit_spec``.\n\nThe primitive synthesizes the framework-required job_env keys\nand emits a validated submit_flow.input.json spec ready for\nsubmit-flow.",
      "properties": {
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "cluster": {
          "minLength": 1,
          "title": "Cluster",
          "type": "string"
        },
        "ssh_target": {
          "pattern": "^[^@]+@[^@]+$",
          "title": "Ssh Target",
          "type": "string"
        },
        "remote_path": {
          "minLength": 1,
          "title": "Remote Path",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[A-Za-z0-9._\\-]+$",
          "title": "Run Id",
          "type": "string"
        },
        "cmd_sha": {
          "pattern": "^[0-9a-f]{8,64}$",
          "title": "Cmd Sha",
          "type": "string"
        },
        "total_tasks": {
          "minimum": 1,
          "title": "Total Tasks",
          "type": "integer"
        },
        "backend": {
          "enum": [
            "sge",
            "slurm",
            "pbspro",
            "torque"
          ],
          "title": "Backend",
          "type": "string"
        },
        "is_gpu": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Gpu"
        },
        "job_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Name"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "modules": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modules"
        },
        "conda_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conda Source"
        },
        "conda_env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conda Env"
        },
        "runtime": {
          "anyOf": [
            {
              "const": "uv",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime"
        },
        "campaign_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9._\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Id"
        },
        "result_dir_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Dir Template"
        },
        "walltime_sec": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Walltime Sec"
        },
        "mem_mb": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mem Mb"
        },
        "cpus": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpus"
        },
        "canary": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canary"
        },
        "partial_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Ok"
        },
        "invalidate_on_code_change": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidate On Code Change"
        },
        "pass_env_keys": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Env Keys"
        },
        "rsync_excludes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rsync Excludes"
        },
        "slurm_account": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slurm Account"
        },
        "slurm_cluster": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slurm Cluster"
        },
        "extra_env": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra Env"
        },
        "service_env": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Env"
        }
      },
      "required": [
        "profile",
        "cluster",
        "ssh_target",
        "remote_path",
        "run_id",
        "cmd_sha",
        "total_tasks",
        "backend"
      ],
      "title": "build-submit-spec input",
      "type": "object"
    },
    "BuildTasksPyInput": {
      "additionalProperties": false,
      "description": "Axes spec + per-executor flag declarations for the ``tasks.py`` scaffold.\n\nDrives ``hpc_agent.incorporation.build.tasks_py`` to scaffold\n``<experiment>/.hpc/tasks.py``. Two modes:\n\n* **cartesian** (``data_axis`` omitted) — ``axes`` is a cartesian\n  product, one independent task per cell.\n* **planner** (``data_axis`` present) — ``axes`` is the *sweep* and\n  the series axis is partitioned by ``hpc_agent.experiment_kit.plan_tasks``\n  per the classified ``DataAxis``.",
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/_AxisSpec"
          },
          "minItems": 1,
          "title": "Axes",
          "type": "array"
        },
        "flags_by_executor": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/_FlagSpec"
            },
            "type": "array"
          },
          "minProperties": 1,
          "title": "Flags By Executor",
          "type": "object"
        },
        "force": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Force"
        },
        "data_axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/_DataAxisSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When set, emit a planner-driven tasks.py instead of a cartesian one."
        }
      },
      "required": [
        "axes",
        "flags_by_executor"
      ],
      "title": "build-tasks-py input",
      "type": "object"
    },
    "_AxisSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "values": {
          "items": {},
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "title": "_AxisSpec",
      "type": "object"
    },
    "_DataAxisSpec": {
      "additionalProperties": false,
      "description": "The classified series axis — drives planner-mode codegen.\n\nWhen present on :class:`BuildTasksPyInput`, ``build-tasks-py`` emits a\n``hpc_agent.experiment_kit.plan_tasks``-based ``tasks.py`` (the deterministic\nmaterialisation of the ``/submit-hpc`` Step 3 ``DataAxis`` inference)\ninstead of a cartesian-product one. The cartesian ``axes`` become the\n*sweep* and the series axis is partitioned by the planner.",
      "properties": {
        "kind": {
          "description": "How the series axis is safe to split (classify by reading the experiment's loop and its call graph). 'independent': the loop body is a pure function of its row, no accumulator. 'associative': it accumulates an associative summary (sum / count / min-max / sufficient statistics) — also set `monoid`. 'bounded_halo': it refits or re-reads a trailing window of bounded length (a rolling statistic, a `train_window` look-back) — also set `halo_expr`. 'sequential': unbounded or order-dependent state — not splittable, and the fail-safe default whenever the dependency structure is not unambiguous. The classification must be verified with the serial-elision gate (hpc_agent.experiment_kit.check_elision) before submitting — a misclassified axis returns plausible-but-wrong numbers.",
          "enum": [
            "independent",
            "associative",
            "bounded_halo",
            "sequential"
          ],
          "title": "Kind",
          "type": "string"
        },
        "chunks": {
          "default": 1,
          "description": "Chunks per sweep point. Ignored for kind='sequential'.",
          "minimum": 1,
          "title": "Chunks",
          "type": "integer"
        },
        "series_length": {
          "description": "Length of the series being partitioned (probed by the agent at Step 3).",
          "minimum": 0,
          "title": "Series Length",
          "type": "integer"
        },
        "halo_expr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for kind='bounded_halo': a bare-name arithmetic expression over the run's parameters giving the warm-up row count, e.g. \"train_window * 48\" — the same form stored in axes.yaml. Validated to arithmetic-only (+ - * //, min/max; no calls/attributes/subscripts) before it is rendered.",
          "title": "Halo Expr"
        },
        "monoid": {
          "anyOf": [
            {
              "enum": [
                "sum",
                "moments"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For kind='associative': which built-in monoid chunks reduce with (default: moments).",
          "title": "Monoid"
        }
      },
      "required": [
        "kind",
        "series_length"
      ],
      "title": "_DataAxisSpec",
      "type": "object"
    },
    "_FlagSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "description": "One of int|float|str|bool — the four ctors the scaffold knows how to emit.",
          "enum": [
            "int",
            "float",
            "str",
            "bool"
          ],
          "title": "Type",
          "type": "string"
        },
        "default": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "_FlagSpec",
      "type": "object"
    }
  }
}
